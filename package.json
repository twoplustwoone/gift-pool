  "scripts": {
    "clean:vite": "node -e \"try{require('fs').rmSync('node_modules/.vite',{recursive:true,force:true})}catch(e){}\"",
    "build": "run-s build:*",
    "build:icons": "tsx ./other/build-icons.ts",
    "build:remix": "react-router build",
    "build:server": "tsx ./other/build-server.ts",
    "predev": "npm run build:icons --silent",
    "dev": "node ./server/dev-server.js",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup": "npm run build && prisma generate && prisma migrate deploy && prisma db seed && playwright install",
    "start": "cross-env NODE_ENV=production node .",
    "start:mocks": "cross-env NODE_ENV=production MOCKS=true tsx .",
    "pretest": "run-s build:icons prisma:generate",
    "test": "vitest",
    "precoverage": "run-s build:icons prisma:generate",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:dev --silent",
    "pretest:e2e:dev": "npm run clean:vite",
    "test:e2e:dev": "playwright test --ui",
    "e2e:prepare-db": "cp tests/prisma/base.db tests/prisma/data.1.db && touch tests/prisma/cache.db",
    "pretest:e2e:run": "run-s build prisma:generate e2e:prepare-db",
    "test:e2e:run": "cross-env CI=true DATABASE_URL=file:$(pwd)/tests/prisma/data.1.db DATABASE_PATH=$(pwd)/tests/prisma/data.1.db CACHE_DATABASE_PATH=$(pwd)/tests/prisma/cache.db SESSION_SECRET=SESSION_SECRET INTERNAL_COMMAND_TOKEN=INTERNAL_COMMAND_TOKEN HONEYPOT_SECRET=HONEYPOT_SECRET playwright test",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "ensure:admin": "node other/ensure-admin.js",
    "storybook": "cross-env STORYBOOK=1 storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/playwright-report",
    "/server-build"
